. ********
. *
. *       2. Label topics and parties
. *
. ********
. 
.         **Short x-axis labels, in the order the battery was asked
.         gen byte topic = .
{txt}(9 missing values generated)

{com}.         replace topic = 1 if question == 42
{txt}(3 real changes made)

{com}.         replace topic = 2 if question == 44
{txt}(3 real changes made)

{com}.         replace topic = 3 if question == 45
{txt}(3 real changes made)

{com}. 
.         label define topic      1 "The U.S. budget deficit"                     ///
>                                                 2 "Health in developing countries"      ///
>                                                 3 "How the world sees the U.S."
{txt}
{com}.         label values topic topic
{txt}
{com}.         label variable topic "USAID changes have had an impact on..."
{txt}
{com}. 
.         **Party identification from question 48; leaners (question 49) are not folded in
.         gen byte party = .
{txt}(9 missing values generated)

{com}.         replace party = 1 if party_name == "Democrat"
{txt}(3 real changes made)

{com}.         replace party = 2 if party_name == "Independent"
{txt}(3 real changes made)

{com}.         replace party = 3 if party_name == "Republican"
{txt}(3 real changes made)

{com}. 
.         label define party 1 "Democrat" 2 "Independent" 3 "Republican"
{txt}
{com}.         label values party party
{txt}
{com}.         label variable party "Party identification"
{txt}
{com}. 
.         label variable negative  "Negative impact"
{txt}
{com}.         label variable no_impact "No impact"
{txt}
{com}.         label variable positive  "Positive impact"
{txt}
{com}. 
.         **One row per topic x party, as graph bar (asis) requires
.         isid topic party
{txt}
{com}.         sort topic party
{txt}
{com}. 
. 
. ********
. *
. *       3. Figure of impact by topic and party
. *
. ********
. 
.         **Segments stack bottom to top in the order listed: negative, no impact,
.         **positive. Don't know and refused run from 0 to 1 percent and are left out,
.         **so a few bars stop at 99 rather than 100.
.         graph bar (asis) negative no_impact positive,                                                   ///
>                 over(party, label(labsize(medsmall) angle(45)))                                         ///
>                 over(topic, label(labsize(medium)) gap(90))                                                     ///
>                 stack                                                                                                                           ///
>                 bar(1, color("178 24 43"))                                                                                      ///
>                 bar(2, color("150 150 150"))                                                                            ///
>                 bar(3, color("33 102 172"))                                                                                     ///
>                 blabel(bar, format(%3.0f) position(center) size(vsmall) color(white))   ///
>                 ytitle("Percent of respondents", size(small))                                           ///
>                 ylabel(0(20)100, angle(0) labsize(vsmall) grid glcolor(gs14))           ///
>                 yscale(range(0 100))                                                                                            ///
>                 title("In your opinion, what kind of impact have changes to"            ///
>                         "USAID made to...", size(medsmall) span)                                                ///
>                 note("Source: KFF Poll, April 2026 Health Tracking Poll (Roper #31125187), questions 42, 44 and 45, crossed by party ID (question 48)." ///
>                         "Fielded by SSRS, April 14-19, 2026; national sample of 1,343 U.S. adults, of whom 1,242 give a party ID. Weighted percentages,"                ///
>                         "margin of error +/- 3 points. Don't know and refused, 1 percent or less in every group, are not shown.",                                                               ///
>                         size(small) span)                                                                                               ///
>                 legend(order(3 2 1) rows(1) size(medsmall) pos(6) ring(1)                       ///
>                         region(lstyle(none)) symxsize(4) symysize(3))                                   ///
>                 graphregion(color(white)) plotregion(color(white))                                      ///
>                 xsize(10.5) ysize(6)                                                                                            ///
>                 name(usaid_impact, replace)
{res}{txt}
{com}. 
.         graph export "${c -(}tabsfigspath{c )-}memo3_usaid_impact.png", width(2400) replace
